YSI_AUTH_SECRET=replace-with-long-random-string
YSI_CORS_ORIGINS=https://yourshop.example.com,http://localhost:5500
YSI_REDIS_URL=redis://127.0.0.1:6379
YSI_DB=sqlite
YSI_PORT=8080
YSI_COMMISSION_RATE=0.05
YSI_LOG_FILE=logs/api.log
YSI_EMAIL_MODE=file
# YSI_SMTP_HOST=smtp.example.com
# YSI_SMTP_PORT=587
# YSI_SMTP_USER=
# YSI_SMTP_PASS=
# YSI_MAIL_FROM=noreply@yourshop.id

# --- Midtrans Snap (payment gateway) ---
# Daftar di https://dashboard.sandbox.midtrans.com
# Kosongkan SERVER_KEY untuk mode mock murni.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=0
# Konversi total internal (USD-style) → IDR integer untuk Midtrans
YSI_IDR_RATE=16000
