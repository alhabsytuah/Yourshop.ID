[Unit]
Description=YourShop.Id C++ API
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/yourshop
Environment=YSI_PORT=8080
Environment=YSI_REDIS_URL=redis://127.0.0.1:6379
Environment=YSI_CORS_ORIGINS=https://yourshop.example.com,http://localhost:5500
Environment=YSI_AUTH_SECRET=change-me-to-a-long-random-secret
# Environment=YSI_HTTPS=1
ExecStart=/opt/yourshop/server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
