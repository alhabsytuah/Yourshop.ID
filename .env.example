# YourShop.Id environment example
# Copy to .env and adjust (never commit .env)

YSI_PORT=8080
YSI_AUTH_SECRET=change-me-to-a-long-random-string
YSI_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
YSI_REDIS_URL=redis://127.0.0.1:6379
YSI_DB=json
# YSI_DB=sqlite
YSI_COMMISSION_RATE=0.05
YSI_HTTPS=0
